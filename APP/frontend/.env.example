# =====================================================================
# Frontend environment configuration — copy to `.env` and fill in values.
#   cp .env.example .env
# Vite only exposes vars prefixed with VITE_ to the browser.
# =====================================================================

# Base URL of the backend API host (no trailing slash, no /api suffix).
# The client appends "/api" itself. In production set this to your deployed
# backend, e.g. https://api.yourdomain.com
VITE_BACKEND_URL="http://localhost:8001"

# ---------- Clerk (authentication) ----------
# Publishable key from the Clerk dashboard (API Keys). Starts pk_test_ /
# pk_live_. Safe to ship in the bundle by design — it identifies the Clerk
# instance to the browser and grants nothing on its own. The SECRET key
# (sk_...) belongs only in the backend environment; never put it here.
VITE_CLERK_PUBLISHABLE_KEY=""

# Optional: override the marketing site origin (illinoisjobtracker.com).
# The app links back to it for the landing page, pricing, and all legal
# pages. Point this at a preview deploy when testing the pair together.
VITE_MARKETING_URL="https://illinoisjobtracker.com"

# Optional: Sentry error tracking. Leave blank to disable entirely.
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT="production"
VITE_SENTRY_TRACES_SAMPLE_RATE="0.1"
