# =====================================================================
# Frontend environment configuration — copy to `.env` and fill in values.
#   cp .env.example .env
# Create React App only exposes vars prefixed with REACT_APP_ to the browser.
# =====================================================================

# Base URL of the backend API host (no trailing slash, no /api suffix).
# The client appends "/api" itself. In production set this to your deployed
# backend, e.g. https://api.yourdomain.com
REACT_APP_BACKEND_URL="http://localhost:8001"

# Optional: enable the dev health-check plugin (see craco.config.js).
ENABLE_HEALTH_CHECK="false"

# Optional: Sentry error tracking. Leave blank to disable entirely.
REACT_APP_SENTRY_DSN=""
REACT_APP_SENTRY_ENVIRONMENT="production"
REACT_APP_SENTRY_TRACES_SAMPLE_RATE="0.1"
