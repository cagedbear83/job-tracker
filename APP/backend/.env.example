# =====================================================================
# Backend environment configuration — copy to `.env` and fill in values.
#   cp .env.example .env
# Never commit the real .env (it is gitignored).
# =====================================================================

# ---------- Required (backend will not start without these) ----------
# For MongoDB Atlas use the SRV connection string, e.g.
#   mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URL="mongodb://localhost:27017"
DB_NAME="ides_tracker_db"

# ---------- MongoDB connection tuning (optional; sensible defaults) ----------
MONGO_APP_NAME="ides-job-tracker"
MONGO_MAX_POOL_SIZE="20"
MONGO_MIN_POOL_SIZE="0"
MONGO_SERVER_SELECTION_TIMEOUT_MS="5000"
MONGO_CONNECT_TIMEOUT_MS="10000"
# ---------- Clerk (authentication) ----------
# Clerk owns sign-up, sign-in, email verification, password reset, MFA and the
# Google / Apple providers. This service only VERIFIES Clerk session tokens.
#
# CLERK_ISSUER is your Clerk Frontend API URL — it is the `iss` claim on every
# session token, and its /.well-known/jwks.json is where the public signing
# keys are fetched from. Find it in the Clerk dashboard under API Keys
# (shown as "Frontend API URL").
#   development: https://<your-subdomain>.clerk.accounts.dev
#   production:  https://clerk.illinoisjobtracker.app  (after DNS setup)
# Verify your value before deploying:
#   curl -s "$CLERK_ISSUER/.well-known/jwks.json" | head -c 60
# should return {"keys":[...  — the backend fetches exactly this URL at startup
# and refuses to boot if it does not, naming the URL it tried.
CLERK_ISSUER=""

# Backend API key — starts sk_test_ / sk_live_. SECRET: never commit a real
# value and never expose it to the browser.
CLERK_SECRET_KEY=""

# Optional hardening. Clerk puts the requesting origin in the token's `azp`
# claim; listing origins here rejects a token minted for a different site on
# the same Clerk instance. Comma-separated; empty disables the check.
CLERK_AUTHORIZED_PARTIES="https://illinoisjobtracker.app,http://localhost:3000"

# Comma-separated emails granted admin + platform_admin on first sign-in.
# This replaced ADMIN_EMAIL/ADMIN_PASSWORD: authorization still lives in this
# database, so nothing configured in Clerk can hand out platform admin.
ADMIN_EMAILS=""

# ---------- Session security ----------
# Nothing to configure. Clerk issues short-lived session tokens and the client
# refreshes them itself, so the access-token lifetime, the rotating refresh
# token, and its httpOnly cookie flags are all gone. Session lifetime is set in
# the Clerk dashboard under Sessions.

# ---------- CORS ----------
# Comma-separated list of allowed origins. Use explicit origins in production
# (never "*" once cookies/credentials are involved).
CORS_ORIGINS="*"

# ---------- Production hardening (all optional) ----------
# Error tracking; leave blank to disable Sentry entirely.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="0.1"
# Per-IP auth rate limits. Toggle off for test runs that hammer /auth/login.
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_REGISTER="3/hour"
RATE_LIMIT_FORGOT="3/hour"
# Optional shared store (e.g. redis://...) so limits hold across workers.
RATE_LIMIT_STORAGE_URI=""
# Rate-limit key source. When "true", the limiter keys off the left-most
# X-Forwarded-For hop (the real client) instead of the proxy's IP, so users
# aren't bucketed together behind a load balancer. Only enable behind a
# trusted proxy that sets X-Forwarded-For (e.g. DigitalOcean App Platform);
# otherwise clients can spoof the header to dodge limits.
TRUST_PROXY="true"
# Send HSTS header (only behind TLS / in production).
ENABLE_HSTS="false"
# Grace period (days) granted to a paid subscription whose current_period_end
# couldn't be resolved from Stripe. After this window (measured from the record's
# last update) the user fails closed to the free tier. Keep short.
SUBSCRIPTION_GRACE_DAYS="3"

# ---------- Email (Mailgun) — optional; email features no-op if unset ----------
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_FROM="Illinois UI Tracker <noreply@yourdomain.com>"
# Shown in the admin integrations panel; the verified sending domain.
MAILGUN_VERIFIED_DOMAIN=""
# Fallback sender used when the verified domain is unavailable.
MAILGUN_FALLBACK_FROM="onboarding@mailgun.com"

# ---------- SMS (ClickSend) — optional; SMS features no-op if unset ----------
# Your ClickSend dashboard login email (Dashboard > Account Settings).
CLICKSEND_USERNAME=""
# API key, NOT your account password (Dashboard > API Credentials).
CLICKSEND_API_KEY=""
# Optional: a verified ClickSend Sender ID / dedicated number. Leave blank to
# send from ClickSend's shared/random sender pool.
CLICKSEND_FROM_NUMBER=""
# Minimum minutes between SMS sends to the same number (abuse guard).
SMS_MIN_INTERVAL_MINUTES="30"

# ---------- AI screenshot OCR (Google Gemini) — optional ----------
GEMINI_API_KEY=""

# ---------- Development helpers ----------
# Demo/admin account seeding was removed. An account that exists only in Mongo
# can never be signed in to now that Clerk owns credentials — create test
# accounts by signing up, and grant admin via ADMIN_EMAILS above.

# ---------- Admin platform (ported from admin_portal) — all optional ----------
# One-time promotion target for bootstrap_admin.py. See that script's
# docstring — usually unnecessary, since an existing role="admin" account
# already gets platform_admin access automatically via rbac.py's fallback.
BOOTSTRAP_ADMIN_EMAIL=""
# Max concurrent active comps (admin_platform_comps.py). Unset = uncapped.
PLATFORM_COMP_CAP=""
# Link surfaced in the admin System panel; purely informational.
SENTRY_DASHBOARD_URL=""
# "dev"/"test"/"development" disables the comp cap even when set.
APP_ENV=""
