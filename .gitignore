# ==========================================================================
# Root .gitignore — applies to the whole repo. Subtrees (e.g. APP/) may add
# their own .gitignore for more specific rules.
# ==========================================================================

# ---------- Secrets & environment ----------
.env
.env.*
!.env.example
*.env
*.pem
*token.json*
*credentials.json*

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.wbk
*.swp

# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---------- Builds / caches ----------
/build
build/
dist/
/out/
/.next/
.cache/
*.tsbuildinfo
/coverage
.vercel

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# ---------- Backups & large/archive artifacts ----------
*.bak
*.orig
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
*.pack

# ---------- Tooling scratch ----------
.tmp.driveupload/
.claude/
