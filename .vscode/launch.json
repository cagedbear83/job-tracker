{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🐍 Debug Backend (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "server:app",
        "--reload",
        "--port",
        "8001"
      ],
      "jinja": true,
      "justMyCode": false,
      "cwd": "${workspaceFolder}/APP/backend",
      "envFile": "${workspaceFolder}/APP/backend/.env",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/APP/backend"
      }
    },
    {
      "name": "🐍 Debug Backend (No Reload — Required for Breakpoints)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "server:app",
        "--port",
        "8001"
      ],
      "jinja": true,
      "justMyCode": false,
      "cwd": "${workspaceFolder}/APP/backend",
      "envFile": "${workspaceFolder}/APP/backend/.env",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/APP/backend"
      }
    },
    {
      "name": "🧪 Debug Pytest (All Tests)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${workspaceFolder}/APP/tests",
        "-v"
      ],
      "jinja": true,
      "justMyCode": false,
      "cwd": "${workspaceFolder}/APP/backend",
      "envFile": "${workspaceFolder}/APP/backend/.env",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/APP/backend"
      }
    },
    {
      "name": "🧪 Debug Pytest (Single Test File)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-v",
        "-s"
      ],
      "jinja": true,
      "justMyCode": false,
      "cwd": "${workspaceFolder}/APP/backend",
      "envFile": "${workspaceFolder}/APP/backend/.env",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/APP/backend"
      }
    }
  ]
}
